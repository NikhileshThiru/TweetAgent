# ============================================================================
# Environment variables
# ============================================================================
# There is no local server anymore — generation runs as a Vercel function
# (ui/api/generate.py), triggered by Supabase Cron (hourly) and the UI button.
# These are set in the Vercel dashboard (Project → Settings → Environment
# Variables) as SERVER-side vars. For local --dry-run testing you only need
# GEMINI_API_KEY (and SUPABASE_* if you want a real insert).

# ---- Vercel function (server-side; never exposed to the browser) -----------
GEMINI_API_KEY=
SUPABASE_URL=                 # https://<project>.supabase.co
SUPABASE_SERVICE_KEY=         # service_role key — bypasses RLS so the function can write. SECRET.
SUPABASE_ANON_KEY=            # anon key — used to verify the owner's login token on button calls.
OWNER_EMAIL=                  # your email; only this user's button presses are allowed.
CRON_SECRET=                  # random string; must match the value in supabase/cron.sql.
                              # generate one with:  openssl rand -hex 32
AUTHOR_PROFILE=               # optional: a few bullet lines describing whose voice to
                              # write in (interests, what they build). Falls back to a
                              # generic builder persona if unset. Keeps your bio out of the repo.
MICROLINK_API_KEY=            # optional: raises Microlink's free 50/day limit for the
                              # article preview-image lookups. Works without one at 50/day.

# ---- React UI (Vite — PUBLIC, baked into the browser bundle) ---------------
# Set these in Vercel too, and in ui/.env.local for local dev.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=       # anon/public key — safe to expose ONLY because RLS is enabled.
